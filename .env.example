# Copy to .env locally. Do not commit real credentials.
APP_ENV=development
APP_VERSION=1.2.0
PERSISTENCE_BACKEND=memory
DATABASE_URL=postgresql://nobleport:change-me@localhost:5432/nobleport
GCAGENT_API_TOKENS=replace-with-a-long-random-bearer-token
GCAGENT_MAX_UPLOAD_BYTES=26214400
GCAGENT_ALLOWED_AUDIO_TYPES=audio/mpeg,audio/mp4,audio/wav,audio/x-wav,audio/webm,audio/ogg
N8N_WEBHOOK_URL=
N8N_TIMEOUT_SECONDS=10
SLACK_SIGNING_SECRET=
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Docker Compose only
POSTGRES_DB=nobleport
POSTGRES_USER=nobleport
POSTGRES_PASSWORD=replace-with-a-long-unique-local-secret
